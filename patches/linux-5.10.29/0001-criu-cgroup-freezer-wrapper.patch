--- a/kernel/cgroup/cgroup.c
+++ b/kernel/cgroup/cgroup.c
@@ -31,6 +31,8 @@
 #include "cgroup-internal.h"
+#include "../../fs/kernfs/kernfs-internal.h"

 #include <linux/cred.h>
+#include <linux/criu_freezer.h>
 #include <linux/errno.h>
 #include <linux/init_task.h>
 #include <linux/kernel.h>
@@ -5570,0 +5570,229 @@
+/*
+ * A narrow in-kernel cgroup-v2 freezer boundary for CRIU's out-of-tree
+ * module.  The module must not depend on cgroup-internal.h: cgroup creation,
+ * migration and freezer transitions all remain inside this translation unit.
+ */
+struct criu_freezer_cookie {
+	struct cgroup *original;
+	struct cgroup *temporary;
+	struct task_struct *leader;
+};
+static atomic64_t criu_freezer_seq = ATOMIC64_INIT(0);
+
+static int criu_freezer_destroy_temporary(struct cgroup *temporary)
+{
+	int ret;
+
+	if (!temporary)
+		return -EINVAL;
+
+	mutex_lock(&cgroup_mutex);
+	ret = cgroup_destroy_locked(temporary);
+	mutex_unlock(&cgroup_mutex);
+	if (ret)
+		pr_warn("CRIU freezer: unable to remove temporary cgroup (%d)\n",
+			ret);
+	return ret;
+}
+
+/* cgroup_mkdir() is a kernfs write callback and requires an active parent
+ * reference.  The exported wrapper is called from a module, so reproduce
+ * its create/activate sequence while holding cgroup_mutex. */
+static struct cgroup *criu_freezer_create_child(struct cgroup *parent,
+						const char *name, umode_t mode)
+{
+	struct cgroup *cgrp;
+	struct kernfs_node *active_parent;
+	int ret;
+
+	active_parent = kernfs_get_active(parent->kn);
+	if (!active_parent) {
+		pr_info("CRIU freezer: parent active reference failed\n");
+		return ERR_PTR(-ENODEV);
+	}
+	mutex_lock(&cgroup_mutex);
+	if (!cgroup_check_hierarchy_limits(parent)) {
+		mutex_unlock(&cgroup_mutex);
+		kernfs_put_active(active_parent);
+		return ERR_PTR(-EAGAIN);
+	}
+	cgrp = cgroup_create(parent, name, mode);
+	if (IS_ERR(cgrp)) {
+		pr_info("CRIU freezer: cgroup_create failed %ld\n", PTR_ERR(cgrp));
+		mutex_unlock(&cgroup_mutex);
+		kernfs_put_active(active_parent);
+		return cgrp;
+	}
+	kernfs_get(cgrp->kn);
+	ret = cgroup_kn_set_ugid(cgrp->kn);
+	if (ret)
+		pr_info("CRIU freezer: set_ugid failed %d\n", ret);
+	if (!ret)
+		ret = css_populate_dir(&cgrp->self);
+	if (!ret)
+		ret = cgroup_apply_control_enable(cgrp);
+	if (!ret) {
+		kernfs_activate(cgrp->kn);
+		mutex_unlock(&cgroup_mutex);
+		kernfs_put_active(active_parent);
+		return cgrp;
+	}
+	cgroup_destroy_locked(cgrp);
+	mutex_unlock(&cgroup_mutex);
+	kernfs_put_active(active_parent);
+	return ERR_PTR(ret);
+}
+int criu_cgroup_freeze_threadgroup(struct task_struct *leader,
+				   struct criu_freezer_cookie **cookie,
+				   char *original_path, size_t original_len,
+				   char *temporary_path, size_t temporary_len)
+{
+	struct criu_freezer_cookie *ctx;
+	struct cgroup *original = NULL, *temporary = NULL;
+	char name[64];
+	int ret, path_len;
+	bool threadgroup_locked = false;
+
+	if (!leader || !cookie || !original_path || !temporary_path ||
+	    !original_len || !temporary_len ||
+	    leader != leader->group_leader)
+		return -EINVAL;
+	if (*cookie)
+		return -EBUSY;
+
+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	/* Exclude fork and cgroup migration while taking the threadgroup snapshot. */
+	cgroup_threadgroup_change_begin(leader);
+	threadgroup_locked = true;
+
+	mutex_lock(&cgroup_mutex);
+	spin_lock_irq(&css_set_lock);
+	original = task_cgroup_from_root(leader, &cgrp_dfl_root);
+	if (original && cgroup_on_dfl(original))
+		cgroup_get_live(original);
+	else
+		original = NULL;
+	spin_unlock_irq(&css_set_lock);
+	if (!original) {
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+
+	path_len = cgroup_path(original, original_path, original_len);
+	if (path_len < 0 || path_len >= original_len) {
+		ret = -ENAMETOOLONG;
+		goto out_put_original;
+	}
+	mutex_unlock(&cgroup_mutex);
+
+	ret = scnprintf(name, sizeof(name), "criu-freeze-%llu",
+			(unsigned long long)atomic64_inc_return(&criu_freezer_seq));
+	if (ret >= sizeof(name)) {
+		ret = -ENAMETOOLONG;
+		goto out_put_original_unlocked;
+	}
+
+	temporary = criu_freezer_create_child(original, name, 0755);
+	ret = PTR_ERR_OR_ZERO(temporary);
+	if (ret) {
+		temporary = NULL;
+		goto out_put_original_unlocked;
+	}
+	cgroup_get_live(temporary);
+
+	if (!strcmp(original_path, "/"))
+		ret = scnprintf(temporary_path, temporary_len, "/%s", name);
+	else
+		ret = scnprintf(temporary_path, temporary_len, "%s/%s",
+				original_path, name);
+	if (ret < 0 || ret >= temporary_len) {
+		ret = -ENAMETOOLONG;
+		goto out_destroy_temporary;
+	}
+
+
+	mutex_lock(&cgroup_mutex);
+	pr_info("CRIU freezer: attaching pid=%d\n", task_pid_vnr(leader));
+	ret = cgroup_attach_task(temporary, leader, true);
+	pr_info("CRIU freezer: attach returned %d\n", ret);
+	if (!ret)
+		pr_info("CRIU freezer: requesting freeze\n");
+	if (!ret)
+		cgroup_freeze(temporary, true);
+	pr_info("CRIU freezer: freeze request returned\n");
+	mutex_unlock(&cgroup_mutex);
+	if (ret)
+		goto out_destroy_temporary;
+
+	get_task_struct(leader);
+	ctx->original = original;
+	ctx->temporary = temporary;
+	ctx->leader = leader;
+	*cookie = ctx;
+	cgroup_threadgroup_change_end(leader);
+	return 0;
+
+out_destroy_temporary:
+	criu_freezer_destroy_temporary(temporary);
+	cgroup_put(temporary);
+out_put_original_unlocked:
+	cgroup_put(original);
+	if (threadgroup_locked)
+		cgroup_threadgroup_change_end(leader);
+	kfree(ctx);
+	return ret;
+
+out_put_original:
+	cgroup_put(original);
+out_unlock:
+	mutex_unlock(&cgroup_mutex);
+	if (threadgroup_locked)
+		cgroup_threadgroup_change_end(leader);
+	kfree(ctx);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(criu_cgroup_freeze_threadgroup);
+
+int criu_cgroup_thaw_threadgroup(struct criu_freezer_cookie *ctx)
+{
+	struct cgroup *original, *temporary;
+	struct task_struct *leader;
+	int ret;
+
+	if (!ctx || !ctx->original || !ctx->temporary || !ctx->leader)
+		return -EINVAL;
+
+	original = ctx->original;
+	temporary = ctx->temporary;
+	leader = ctx->leader;
+	pr_info("CRIU freezer: thaw begin pid=%d\n", task_pid_vnr(leader));
+	cgroup_threadgroup_change_begin(leader);
+	mutex_lock(&cgroup_mutex);
+	cgroup_freeze(temporary, false);
+	ret = cgroup_attach_task(original, leader, true);
+	if (ret)
+		cgroup_freeze(temporary, true);
+	mutex_unlock(&cgroup_mutex);
+	cgroup_threadgroup_change_end(leader);
+	pr_info("CRIU freezer: thaw attach ret=%d\n", ret);
+	if (ret)
+		/* Keep the cookie live so the caller can retry thaw. */
+		return ret;
+
+	ret = criu_freezer_destroy_temporary(temporary);
+	pr_info("CRIU freezer: thaw destroy ret=%d\n", ret);
+	if (ret)
+		/* Membership is restored; keep refs for a retry of cgroup_rmdir. */
+		return ret;
+
+	cgroup_put(temporary);
+	cgroup_put(original);
+	put_task_struct(leader);
+	kfree(ctx);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(criu_cgroup_thaw_threadgroup);
+
