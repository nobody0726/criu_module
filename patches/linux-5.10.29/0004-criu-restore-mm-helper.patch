--- a/mm/mremap.c
+++ b/mm/mremap.c
@@ -636,0 +637,32 @@ out:
+
+unsigned long criu_restore_mremap_fixed(unsigned long addr, unsigned long len,
+					unsigned long new_addr)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned long ret;
+	bool locked = false;
+	struct vm_userfaultfd_ctx uf = NULL_VM_UFFD_CTX;
+	LIST_HEAD(uf_unmap_early);
+	LIST_HEAD(uf_unmap);
+
+	if (offset_in_page(addr) || offset_in_page(new_addr))
+		return -EINVAL;
+
+	len = PAGE_ALIGN(len);
+	if (!len)
+		return -EINVAL;
+
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+
+	ret = mremap_to(addr, len, new_addr, len, &locked,
+			MREMAP_FIXED | MREMAP_MAYMOVE, &uf,
+			&uf_unmap_early, &uf_unmap);
+
+	mmap_write_unlock(mm);
+	userfaultfd_unmap_complete(mm, &uf_unmap_early);
+	mremap_userfaultfd_complete(&uf, addr, ret, len);
+	userfaultfd_unmap_complete(mm, &uf_unmap);
+
+	return ret;
+}
--- a/kernel/criu_restore.c
+++ b/kernel/criu_restore.c
@@ -0,0 +1,513 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal CRIU restore transaction device for the criu_module B1 track.
+ *
+ * This scaffold establishes /dev/criu_restore, a per-open transaction, and
+ * the VALIDATE/COMMIT boundary.  Later patches fill in actual VMA commit
+ * semantics; this file already enforces that COMMIT only uses the plan copied
+ * during VALIDATE and that the caller is the target carrier PID.
+ */
+#include <linux/capability.h>
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/mman.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <uapi/linux/criu_restore.h>
+
+enum restore_tx_state {
+	RESTORE_TX_OPEN = 0,
+	RESTORE_TX_VALIDATED,
+	RESTORE_TX_COMMITTING,
+	RESTORE_TX_COMMITTED,
+	RESTORE_TX_FAILED,
+};
+
+struct criu_restore_tx {
+	struct mutex lock;
+	enum restore_tx_state state;
+	const struct cred *opener_cred;
+	struct criu_restore_plan_v1 plan;
+	struct criu_restore_vma_v1 *vmas;
+};
+
+static bool criu_restore_bad_range(__u64 start, __u64 length)
+{
+	if (!length)
+		return true;
+	if (start & ~PAGE_MASK)
+		return true;
+	if (length & ~PAGE_MASK)
+		return true;
+	if (start + length <= start)
+		return true;
+	return false;
+}
+
+static bool criu_restore_known_vma_kind(__u32 kind)
+{
+	return kind == CRIU_RESTORE_VMA_ANON_PRIVATE ||
+	       kind == CRIU_RESTORE_VMA_FILE_PRIVATE ||
+	       kind == CRIU_RESTORE_VMA_STACK ||
+	       kind == CRIU_RESTORE_VMA_VDSO;
+}
+
+static bool criu_restore_in_range(__u64 value, __u64 start, __u64 length)
+{
+	if (start + length <= start)
+		return false;
+	return value > start && value <= start + length;
+}
+
+static bool criu_restore_in_half_open_range(__u64 value, __u64 start,
+					    __u64 end)
+{
+	if (end <= start)
+		return false;
+	return value >= start && value < end;
+}
+
+static int criu_restore_validate_bootstrap(const struct criu_restore_plan_v1 *plan)
+{
+	if (plan->bootstrap_code_start & ~PAGE_MASK ||
+	    plan->bootstrap_code_end & ~PAGE_MASK ||
+	    plan->bootstrap_stack_start & ~PAGE_MASK ||
+	    plan->bootstrap_stack_end & ~PAGE_MASK)
+		return -EINVAL;
+	if (plan->bootstrap_code_end <= plan->bootstrap_code_start ||
+	    plan->bootstrap_stack_end <= plan->bootstrap_stack_start)
+		return -EINVAL;
+	if (!criu_restore_in_half_open_range(plan->bootstrap_pc,
+					     plan->bootstrap_code_start,
+					     plan->bootstrap_code_end))
+		return -EINVAL;
+	if (!criu_restore_in_range(plan->bootstrap_sp,
+				   plan->bootstrap_stack_start,
+				   plan->bootstrap_stack_end -
+				   plan->bootstrap_stack_start))
+		return -EINVAL;
+	return 0;
+}
+
+static bool criu_restore_sp_in_staging_vmas(const struct criu_restore_plan_v1 *plan,
+					   const struct criu_restore_vma_v1 *vmas,
+					   __u64 sp)
+{
+	u32 i;
+
+	for (i = 0; i < plan->vma_count; i++)
+		if (criu_restore_in_range(sp, vmas[i].staging_start,
+					  vmas[i].length))
+			return true;
+	return false;
+}
+
+static bool criu_restore_sp_in_target_vmas(const struct criu_restore_plan_v1 *plan,
+					  const struct criu_restore_vma_v1 *vmas,
+					  __u64 sp)
+{
+	u32 i;
+
+	for (i = 0; i < plan->vma_count; i++)
+		if (criu_restore_in_range(sp, vmas[i].target_start,
+					  vmas[i].length))
+			return true;
+	return false;
+}
+
+static int criu_restore_validate_sigframe(const struct criu_restore_plan_v1 *plan,
+					 const struct criu_restore_vma_v1 *vmas)
+{
+	if (!criu_restore_sp_in_staging_vmas(plan, vmas,
+					     plan->sigframe_staging_sp))
+		return -EINVAL;
+	if (!criu_restore_sp_in_target_vmas(plan, vmas,
+					    plan->sigframe_final_sp))
+		return -EINVAL;
+	return 0;
+}
+
+static int criu_restore_validate_vmas(const struct criu_restore_plan_v1 *plan,
+				      const struct criu_restore_vma_v1 *vmas)
+{
+	u32 i, j;
+
+	for (i = 0; i < plan->vma_count; i++) {
+		const struct criu_restore_vma_v1 *vma = &vmas[i];
+		__u64 start = vma->target_start;
+		__u64 end = start + vma->length;
+
+		if (criu_restore_bad_range(vma->staging_start, vma->length) ||
+		    criu_restore_bad_range(vma->target_start, vma->length))
+			return -EINVAL;
+		if (!criu_restore_known_vma_kind(vma->kind))
+			return -EOPNOTSUPP;
+		if (vma->flags & ~CRIU_RESTORE_VMA_F_KNOWN)
+			return -EOPNOTSUPP;
+		for (j = 0; j < i; j++) {
+			__u64 old_start = vmas[j].target_start;
+			__u64 old_end = old_start + vmas[j].length;
+
+			if (start < old_end && old_start < end)
+				return -EINVAL;
+		}
+	}
+	return 0;
+}
+
+static int criu_restore_validate_plan(struct criu_restore_tx *tx,
+				      unsigned long arg)
+{
+	struct criu_restore_plan_v1 plan;
+	struct criu_restore_vma_v1 *vmas = NULL;
+	void __user *vmas_user;
+	size_t bytes;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&plan, (void __user *)arg, sizeof(plan)))
+		return -EFAULT;
+	if (plan.version != CRIU_RESTORE_ABI_VERSION ||
+	    plan.size != sizeof(plan) ||
+	    (plan.flags & ~CRIU_RESTORE_PLAN_F_KNOWN) ||
+	    !plan.target_pid ||
+	    plan.reserved0)
+		return -EINVAL;
+	if (!plan.vmas_user_ptr)
+		return -EINVAL;
+	if (!current->mm)
+		return -EINVAL;
+	if (!plan.vma_count || plan.vma_count > CRIU_RESTORE_MAX_VMAS)
+		return -EINVAL;
+	ret = criu_restore_validate_bootstrap(&plan);
+	if (ret)
+		return ret;
+	if (check_mul_overflow((size_t)plan.vma_count, sizeof(*vmas), &bytes))
+		return -EINVAL;
+
+	vmas = kmalloc(bytes, GFP_KERNEL);
+	if (!vmas)
+		return -ENOMEM;
+	vmas_user = (void __user *)(unsigned long)plan.vmas_user_ptr;
+	if (copy_from_user(vmas, vmas_user, bytes)) {
+		ret = -EFAULT;
+		goto out_free;
+	}
+
+	ret = criu_restore_validate_vmas(&plan, vmas);
+	if (ret)
+		goto out_free;
+	ret = criu_restore_validate_sigframe(&plan, vmas);
+	if (ret)
+		goto out_free;
+
+	mutex_lock(&tx->lock);
+	if (tx->state != RESTORE_TX_OPEN) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	tx->plan = plan;
+	tx->vmas = vmas;
+	tx->state = RESTORE_TX_VALIDATED;
+	vmas = NULL;
+	ret = 0;
+out_unlock:
+	mutex_unlock(&tx->lock);
+out_free:
+	kfree(vmas);
+	return ret;
+}
+
+struct criu_restore_range {
+	unsigned long start;
+	unsigned long end;
+};
+
+static void criu_restore_sort_ranges(struct criu_restore_range *ranges, u32 count)
+{
+	u32 i, j;
+
+	for (i = 1; i < count; i++) {
+		struct criu_restore_range key = ranges[i];
+
+		j = i;
+		while (j > 0 && ranges[j - 1].start > key.start) {
+			ranges[j] = ranges[j - 1];
+			j--;
+		}
+		ranges[j] = key;
+	}
+}
+
+static int criu_restore_unmap_old_vmas(const struct criu_restore_plan_v1 *plan,
+				       const struct criu_restore_vma_v1 *vmas)
+{
+	struct mm_struct *mm = current->mm;
+	struct criu_restore_range *keep;
+	unsigned long cursor = 0;
+	u32 i, keep_count = plan->vma_count + 2;
+	int ret = 0;
+
+	keep = kcalloc(keep_count, sizeof(*keep), GFP_KERNEL);
+	if (!keep)
+		return -ENOMEM;
+
+	for (i = 0; i < plan->vma_count; i++) {
+		keep[i].start = vmas[i].staging_start;
+		keep[i].end = vmas[i].staging_start + vmas[i].length;
+	}
+	keep[plan->vma_count].start = plan->bootstrap_code_start;
+	keep[plan->vma_count].end = plan->bootstrap_code_end;
+	keep[plan->vma_count + 1].start = plan->bootstrap_stack_start;
+	keep[plan->vma_count + 1].end = plan->bootstrap_stack_end;
+	criu_restore_sort_ranges(keep, keep_count);
+
+	if (mmap_write_lock_killable(mm)) {
+		ret = -EINTR;
+		goto out;
+	}
+	for (i = 0; i < keep_count; i++) {
+		if (keep[i].end <= cursor)
+			continue;
+		if (keep[i].start > cursor) {
+			ret = do_munmap(mm, cursor, keep[i].start - cursor, NULL);
+			if (ret)
+				break;
+		}
+		cursor = keep[i].end;
+	}
+	if (!ret && cursor < TASK_SIZE)
+		ret = do_munmap(mm, cursor, TASK_SIZE - cursor, NULL);
+	mmap_write_unlock(mm);
+out:
+	kfree(keep);
+	return ret;
+}
+
+static bool criu_restore_ranges_overlap(unsigned long a_start, unsigned long len,
+					unsigned long b_start)
+{
+	return a_start < b_start + len && b_start < a_start + len;
+}
+
+static int criu_restore_map_guard_page(unsigned long guard)
+{
+	unsigned long ret;
+
+	ret = vm_mmap(NULL, guard, PAGE_SIZE, PROT_NONE,
+		      MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	if (ret != guard) {
+		if (!IS_ERR_VALUE(ret))
+			vm_munmap(ret, PAGE_SIZE);
+		return IS_ERR_VALUE(ret) ? ret : -ENOMEM;
+	}
+	return 0;
+}
+
+static unsigned long criu_restore_find_temp_range(unsigned long len)
+{
+	return vm_mmap(NULL, 0, len, PROT_NONE,
+		       MAP_PRIVATE | MAP_ANONYMOUS, 0);
+}
+
+static int criu_restore_move_vma(const struct criu_restore_vma_v1 *vma)
+{
+	unsigned long src = vma->staging_start;
+	unsigned long dst = vma->target_start;
+	unsigned long len = vma->length;
+	unsigned long tmp;
+	int ret;
+
+	if (src == dst)
+		return 0;
+
+	if (criu_restore_ranges_overlap(src, len, dst)) {
+		unsigned long guard;
+		unsigned long temp;
+
+		if (src < dst)
+			guard = dst + len - PAGE_SIZE;
+		else
+			guard = dst;
+		ret = criu_restore_map_guard_page(guard);
+		if (ret)
+			return ret;
+
+		temp = criu_restore_find_temp_range(len);
+		if (IS_ERR_VALUE(temp))
+			return temp;
+		tmp = criu_restore_mremap_fixed(src, len, temp);
+		if (tmp != temp) {
+			vm_munmap(temp, len);
+			return IS_ERR_VALUE(tmp) ? tmp : -EFAULT;
+		}
+		src = temp;
+	}
+
+	tmp = criu_restore_mremap_fixed(src, len, dst);
+	if (tmp != dst)
+		return IS_ERR_VALUE(tmp) ? tmp : -EFAULT;
+	return 0;
+}
+
+static int criu_restore_restore_prot(const struct criu_restore_vma_v1 *vma)
+{
+	return criu_restore_mprotect(vma->target_start, vma->length, vma->prot);
+}
+
+static int criu_restore_commit_vmas(const struct criu_restore_plan_v1 *plan,
+				    const struct criu_restore_vma_v1 *vmas)
+{
+	int ret;
+	int i;
+
+	ret = criu_restore_unmap_old_vmas(plan, vmas);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < plan->vma_count; i++) {
+		if (vmas[i].target_start > vmas[i].staging_start)
+			continue;
+		ret = criu_restore_move_vma(&vmas[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = plan->vma_count - 1; i >= 0; i--) {
+		if (vmas[i].target_start <= vmas[i].staging_start)
+			continue;
+		ret = criu_restore_move_vma(&vmas[i]);
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < plan->vma_count; i++) {
+		ret = criu_restore_restore_prot(&vmas[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int criu_restore_commit(struct criu_restore_tx *tx, unsigned long arg)
+{
+	struct criu_restore_commit_v1 commit;
+	int ret = 0;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (copy_from_user(&commit, (void __user *)arg, sizeof(commit)))
+		return -EFAULT;
+	if (commit.version != CRIU_RESTORE_ABI_VERSION ||
+	    commit.size != sizeof(commit) ||
+	    commit.flags ||
+	    commit.reserved0)
+		return -EINVAL;
+
+	mutex_lock(&tx->lock);
+	if (tx->state != RESTORE_TX_VALIDATED) {
+		ret = -EINVAL;
+		goto out;
+	}
+	/* COMMIT is authorized by the carrier's current->pid / target_pid. */
+	if (task_pid_nr(current) != tx->plan.target_pid) {
+		ret = -EPERM;
+		goto out;
+	}
+
+	tx->state = RESTORE_TX_COMMITTING;
+	ret = criu_restore_commit_vmas(&tx->plan, tx->vmas);
+	if (ret)
+		pr_err("criu_restore: commit pid=%u failed ret=%d\\n",
+		       tx->plan.target_pid, ret);
+	if (!ret)
+		tx->state = RESTORE_TX_COMMITTED;
+out:
+	if (ret && tx->state == RESTORE_TX_COMMITTING) {
+		tx->state = RESTORE_TX_FAILED;
+		force_sig(SIGKILL);
+	}
+	mutex_unlock(&tx->lock);
+	return ret;
+}
+
+static long criu_restore_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long arg)
+{
+	struct criu_restore_tx *tx = file->private_data;
+
+	if (!tx)
+		return -EINVAL;
+	switch (cmd) {
+	case CRIU_RESTORE_VALIDATE_V1:
+		return criu_restore_validate_plan(tx, arg);
+	case CRIU_RESTORE_COMMIT_V1:
+		return criu_restore_commit(tx, arg);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int criu_restore_open(struct inode *inode, struct file *file)
+{
+	struct criu_restore_tx *tx;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	tx = kzalloc(sizeof(*tx), GFP_KERNEL);
+	if (!tx)
+		return -ENOMEM;
+	mutex_init(&tx->lock);
+	tx->state = RESTORE_TX_OPEN;
+	tx->opener_cred = get_current_cred();
+	file->private_data = tx;
+	return 0;
+}
+
+static int criu_restore_release(struct inode *inode, struct file *file)
+{
+	struct criu_restore_tx *tx = file->private_data;
+
+	if (!tx)
+		return 0;
+	kfree(tx->vmas);
+	if (tx->opener_cred)
+		put_cred(tx->opener_cred);
+	kfree(tx);
+	file->private_data = NULL;
+	return 0;
+}
+
+static const struct file_operations criu_restore_fops = {
+	.owner = THIS_MODULE,
+	.open = criu_restore_open,
+	.release = criu_restore_release,
+	.unlocked_ioctl = criu_restore_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = criu_restore_ioctl,
+#endif
+};
